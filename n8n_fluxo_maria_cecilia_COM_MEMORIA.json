      "typeVersion": 1,
      "position": [ 400, 500 ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={\n\"Mensagem recebida\": \"{{ $json.body.data.message.conversation || $json.body.data.message.extendedTextMessage.text || 'Arquivo/Invisivel' }}\",\n\nLeia a mensagem recebida e atue como Maria Cecília de acordo com as diretrizes do Ecossistema Arnaldo Trentin.\nBasta responder naturalmente ao cliente.\n}"
      },
      "id": "3",
      "name": "Inteligência Maria Cecilia",
