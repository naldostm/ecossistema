      "typeVersion": 1.4,
      "position": [ 500, 300 ]
    },
    {
      "parameters": {
        "url": "https://arnaldotrentin.uazapi.com/send/text",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "token", "value": "e7ca3dea-7317-4502-894a-790655f77bb1" },
            { "name": "Accept", "value": "application/json" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"number\": $('Webhook WhatsApp').first().json.body.data.key.remoteJid.replace('@s.whatsapp.net', ''), \"text\": $json.text || $json.output }) }}"
      },
      "id": "4",
