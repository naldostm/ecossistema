        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"tipo\": \"Auditoria de Instalação (Ian)\",\n  \"mensagem\": \"{{ $json.text }}\",\n  \"lida\": false\n}"
