        "headerParameters": { "parameters": [{ "name": "apikey", "value": "[COLE_AQUI]" }, { "name": "Authorization", "value": "Bearer [COLE_AQUI]" }, { "name": "Content-Type", "value": "application/json" }] },
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={\n  \"tipo_movimentacao\": \"{{ $json.text.tipo_entrada_ou_saida }}\",\n  \"descricao\": \"{{ $json.text.descricao_resumida }}\",\n  \"valor\": {{ $json.text.valor_numerico }},\n  \"categoria\": \"{{ $json.text.categoria_financeira }}\"\n}"
      },
      "id": "4", "name": "Lança no Livro Caixa (Supabase)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4, "position": [800, 300]
    }
