    {
      "parameters": {
        "jsCode": "const entrada = $input.first().json;\nlet destino = 'erp';\nlet numero_zap = '';\n\ntry {\n  const zap = $('Normalizador Zap').first();\n  if (zap) {\n    destino = 'whatsapp';\n    numero_zap = zap.json.wpp_jid;\n  }\n} catch (e) {}\n\nreturn [{ json: { origem_rota: destino, wpp_jid: numero_zap, output: entrada.output || entrada.text } }];"
      },
