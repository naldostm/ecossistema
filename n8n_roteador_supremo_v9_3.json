    {
      "parameters": {
        "url": "https://tmpwmtpdxcvulglkahcg.supabase.co/rest/v1/colaboradores?telefone_whatsapp=eq.{{ $('Webhook WhatsApp').item.json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "SEU_TOKEN_AQUI_SEM_COLCHETES" },
            { "name": "Authorization", "value": "Bearer SEU_TOKEN_AQUI_SEM_COLCHETES" }
          ]
        },
        "options": {}
      },
      "name": "Busca Colaborador (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 250, 0 ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst zapNode = $('Webhook WhatsApp').first();\nconst zapJson = zapNode?.json || {};\n\nconst dataRoot = zapJson.body?.data || zapJson.data || zapJson;\nconst msgRoot = dataRoot?.message || {};\nconst keyRoot = dataRoot?.key || {};\n\nconst rawNumber = keyRoot?.remoteJid || zapJson.body?.remoteJid || zapJson.body?.data?.remoteJid || zapNode?.json?.query?.remoteJid || \"\";\nconst rawText = msgRoot?.conversation || msgRoot?.extendedTextMessage?.text || zapJson.body?.text || zapJson.body?.data?.text || \"Apenas Mídia ou Áudio\";\n\nfor (const item of items) {\n  const cargo = item.json.cargo || \"Desconhecido\";\n  let agent = \"Maria Cecília\";\n  \n  if ([\"Técnico\", \"Engenheiro\", \"Supervisor\"].includes(cargo)) agent = \"Ian Gillan\";\n  if (cargo === \"Financeiro\") agent = \"Márcia Ribeiro\";\n  if ([\"Administrador\", \"Diretor\"].includes(cargo)) agent = \"Arquiteto Central\";\n\n  item.json.origem_rota = \"whatsapp\";\n  item.json.destino_agente = agent;\n  item.json.texto_usuario = rawText;\n  item.json.sessionId = rawNumber.replace(\"@s.whatsapp.net\", \"\") || \"telefone_nao_encontrado\";\n  item.json.wpp_jid = rawNumber;\n}\nreturn items;"
      },
      "name": "Normalizador Zap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 500, 0 ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-erp-web",
        "responseMode": "responseNode",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, GET, OPTIONS" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
            ]
          }
        }
      },
      "name": "Webhook ERP Web",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 300 ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  const body = item.json.body;\n  item.json.origem_rota = \"erp\";\n  item.json.destino_agente = body.agentTarget || \"Maria Cecília\";\n  item.json.texto_usuario = body.payload?.text || \"\";\n  item.json.sessionId = body.correlationId || \"erp-session\";\n  item.json.userRole = body.userRole;\n}\nreturn items;"
      },
      "name": "Normalizador ERP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.destino_agente }}",
