{
  "name": "Roteador Supremo V9.1 (WhatsApp + Web App)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-whatsapp-master",
        "options": {}
      },
      "name": "Webhook WhatsApp",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 0 ]
    },
    {
      "parameters": {
        "url": "https://tmpwmtpdxcvulglkahcg.supabase.co/rest/v1/colaboradores?telefone_whatsapp=eq.{{ $('Webhook WhatsApp').item.json.body.data.key.remoteJid.replace('@s.whatsapp.net', '') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "AQUI_O_SEU_TOKEN_SEM_COLCHETES" },
            { "name": "Authorization", "value": "Bearer AQUI_O_SEU_TOKEN_SEM_COLCHETES" }
          ]
        },
        "options": {}
      },
      "name": "Busca Colaborador (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 250, 0 ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst zap = $('Webhook WhatsApp').first().json.body;\n\nfor (const item of items) {\n  const cargo = item.json.cargo || \"Desconhecido\";\n  let agent = \"Maria Cecília\";\n  \n  if ([\"Técnico\", \"Engenheiro\", \"Supervisor\"].includes(cargo)) agent = \"Ian Gillan\";\n  if (cargo === \"Financeiro\") agent = \"Márcia Ribeiro\";\n  if ([\"Administrador\", \"Diretor\"].includes(cargo)) agent = \"Arquiteto Central\";\n\n  item.json.origem_rota = \"whatsapp\";\n  item.json.destino_agente = agent;\n  item.json.texto_usuario = zap.data?.message?.conversation || zap.data?.message?.extendedTextMessage?.text || \"Mídia recebida\";\n  item.json.session_id = zap.data?.key?.remoteJid?.replace(\"@s.whatsapp.net\", \"\") || \"zap-desconhecido\";\n  item.json.wpp_jid = zap.data?.key?.remoteJid;\n}\nreturn items;"
      },
      "name": "Normalizador Zap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 500, 0 ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-erp-web",
        "options": {}
      },
      "name": "Webhook ERP Web",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 300 ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nfor (const item of items) {\n  const body = item.json.body;\n  item.json.origem_rota = \"erp\";\n  item.json.destino_agente = body.agentTarget || \"Maria Cecília\";\n  item.json.texto_usuario = body.payload?.text || \"\";\n  item.json.session_id = body.correlationId || \"erp-session\";\n  item.json.userRole = body.userRole;\n}\nreturn items;"
      },
      "name": "Normalizador ERP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 250, 300 ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.destino_agente }}",
        "rules": {
          "rules": [
            { "value2": "Maria Cecília", "output": 0 },
            { "value2": "Ian Gillan", "output": 1 },
            { "value2": "Márcia Ribeiro", "output": 2 },
            { "value2": "Arquiteto Central", "output": 3 },
            { "value2": "Arquiteto", "output": 3 }
          ]
        },
        "fallbackOutput": 0
      },
      "name": "Switch dos Agentes",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [ 750, 150 ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.texto_usuario }}",
        "options": {
          "systemMessage": "Você é a Maria Cecília. Mantenha as respostas concisas e educadas."
        }
      },
      "name": "IA Maria",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [ 1050, -150 ]
    },
    {
